# AWS Lambda Worker Environment Variables
# Used by serverless.yml for deployment

# Database Configuration
LIVE_MYSQL_CONNECTION_STRING=user:password@tcp(your-db-host:3306)/rs_input_tracker

# RightScale ELSM Account
RS_ELSM_REFRESH_TOKEN=your_elsm_refresh_token
RS_ELSM_ACCOUNT_ID=your_elsm_account_id

# RightScale GCC Account
RS_GCC_REFRESH_TOKEN=your_gcc_refresh_token
RS_GCC_ACCOUNT_ID=your_gcc_account_id

# RightScale S1NA Production Account
RS_S1NAPROD_REFRESH_TOKEN=your_s1naprod_refresh_token
RS_S1NAPROD_ACCOUNT_ID=your_s1naprod_account_id

# AWS Deployment Configuration
ACCOUNT_ID=your_aws_account_id
